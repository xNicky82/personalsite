# Repliers MLS API key (server-side only). Get one at https://repliers.com
# Used by /condos to load live Toronto listings. Without it, the page shows sample data.
REPLIERS_API_KEY=

# --- /legaljobs optional sources (all server-side only) ---------------------
# The board works with no keys (Remotive, Jobicy, The Muse, Arbeitnow, RemoteOK
# are all key-less). These keys simply add MORE postings and salary data.

# Adzuna — huge job aggregator with salaries. Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS — U.S. federal attorney/legal postings. Free key: https://developer.usajobs.gov
# USAJOBS_EMAIL is the email you registered with (sent as the User-Agent).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# The Muse — optional; raises rate limits. Key: https://www.themuse.com/developers/api/v2
MUSE_API_KEY=
