# Repliers MLS API key (server-side only). Get one at https://repliers.com
# Used by /condos to load live Toronto listings. Without it, the page shows sample data.
REPLIERS_API_KEY=

# --- Oura Ring Promo demo alerts (/api/hubspot-webhook) ---
# HubSpot private app token. Scopes: crm.objects.deals.read,
# crm.objects.contacts.read, crm.objects.companies.read, crm.objects.owners.read
HUBSPOT_PRIVATE_APP_TOKEN=
# The private app's client secret, used to verify X-HubSpot-Signature-v3.
HUBSPOT_WEBHOOK_SECRET=
# Only needed when the deployment sits behind a rewrite and the request URL does
# not match the URI HubSpot signed.
HUBSPOT_WEBHOOK_URI=

# Grading. ANTHROPIC_MODEL and ANTHROPIC_WEB_SEARCH_TOOL are optional overrides
# (defaults: claude-sonnet-5 and web_search_20260209).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WEB_SEARCH_TOOL=

# Slack bot token. Scopes: chat:write (and users:read if AE ids are ever
# resolved dynamically rather than from the map in lib/oura-alerts/config.ts).
SLACK_BOT_TOKEN=

# Shadow mode sends every alert to SHADOW_RECIPIENT only. Anything other than
# the literal "false" keeps it on.
SHADOW_MODE=true
SHADOW_RECIPIENT=U0BAPSYFLSV

# Dedupe store. Either the Vercel KV pair or the Upstash pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
